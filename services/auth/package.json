    "@andpay/ids": "workspace:*",
    "@andpay/keys": "workspace:*",
    "@andpay/outbox": "workspace:*",
    "@node-rs/argon2": "^2.0.0",
    "jose": "^5.9.6",
    "otplib": "^12.0.1"
  }
