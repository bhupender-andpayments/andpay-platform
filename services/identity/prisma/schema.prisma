// Identity Registry persistence (handoff spec 05, built on spec 02 topology).
// Pinned to the `identity` schema of the shared instance via the ?schema=
// parameter in IDENTITY_DATABASE_URL; this client can never see another
// context's schema (C4). Domain tables: merchant (canonical identity),
// merchant_bank_ref (the DB-enforced (tenant, bank reference) merchant resolver,
// Fork B), tenant (the sponsor bank as a portal-access tenant), program (the
// sponsorship wrapper), enrollment (the sponsorship relationship). Plus the
// shared outbox (E1) and inbox (E6). No KYC (bank-held, K3), no money (S20).

datasource db {
  provider = "postgresql"
  url      = env("IDENTITY_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

/// The canonical merchant (07.A class 2). One legal entity, one mrch_ (I1),
/// Program-agnostic. Carries NO tenant_id / bank_id / program_id /
/// bank_merchant_reference column (I5, T3: neither sponsorship nor a bank-scoped
/// reference is ever a merchant attribute) and NO KYC/PAN/GSTIN (K3, bank-held).
model Merchant {
  id                String   @id @db.Uuid
  displayName       String   @map("display_name")
  legalName         String   @map("legal_name")
  mcc               String
  registeredAddress String   @map("registered_address")
  activationState   String   @map("activation_state")
  status            String // ACTIVE | SUSPENDED (a status, never a delete)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subMerchants SubMerchant[]

  @@map("merchant")
}

/// The Identity-owned sub-merchant (the 3-tier mrch_ -> smrch_ -> asgn_ model,
/// asgn_ lives in TMS and is out of scope here). Exactly ONE default smrch_ is
/// auto-created per mrch_ at ingest (1:1 in v1). A real intra-schema FK to
/// merchant is allowed and required (same Identity schema, C4-safe); never
/// thread smrch_ into another context's DB. status is cascade-ready for a
/// later spec once a merchant-suspend surface exists; no cascade logic today.
model SubMerchant {
  id                String   @id @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  merchant          Merchant @relation(fields: [merchantId], references: [id])
  registeredAddress String   @map("registered_address")
  status            String // ACTIVE | SUSPENDED (mirrors merchant.status; a status, never a delete)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("sub_merchant")
}

/// The Identity-owned merchant resolver (Fork B). The DB-ENFORCED
/// (tenant, bank_merchant_reference) to mrch_ dedup: UNIQUE fails a concurrent
/// double-mint closed, a boundary not a lint. Identity RESOLUTION, a fact
/// distinct from sponsorship (T2); carries no program_id. The tenant-scoped
/// reference and the vpa dedup hint live here, never on the merchant (I5) and
/// never on the enrollment.
model MerchantBankRef {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  bankMerchantReference String   @map("bank_merchant_reference")
  merchantId            String   @map("merchant_id") @db.Uuid
  vpaHint               String?  @map("vpa_hint")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, bankMerchantReference])
  @@map("merchant_bank_ref")
}

/// The sponsor bank as a portal-access tenant (I5). NOT a bank_ counterparty id
/// (that is Counterparty Directory's namespace, not built in the soundbox).
model Tenant {
  id                String   @id @db.Uuid
  displayName       String   @map("display_name")
  bankReferenceCode String   @unique @map("bank_reference_code")
  status            String
  // BRD Annexure D.1 Bank Master address/contact, admin-owned (createBankMaster
  // /editBankMaster). ALL nullable at the DB level even though BRD D.1 marks
  // most mandatory: the ingest auto-mint (resolveTenant) inserts a tenant with
  // NONE of these set and must keep working, so the mandatory/optional rule is
  // enforced in the admin-write application layer, never as a DB NOT NULL that
  // would break the ingest INSERT. bankReferenceCode above stays the immutable
  // ingest resolver key; these columns are never written by ingest.
  address1          String?  @map("address1")
  address2          String?  @map("address2")
  address3          String?  @map("address3")
  city              String?
  district          String?
  country           String?
  pin               String?
  mobile            String?
  email             String?

  @@map("tenant")
}

/// The Program (the sponsorship wrapper), Program-scoped by its own id. STATED
/// V1 ASSUMPTION (not corpus law): one Program per bank per product for the
/// soundbox, so the Program is derivable from (tenant, product_type) with no
/// discriminator in the row fact. UNIQUE(tenant_id, product_type) enforces it;
/// cheap to relax later (drop the unique, add a scheme discriminator).
model Program {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productType String   @map("product_type")
  status      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, productType])
  @@map("program")
}

/// The sponsorship relationship only (07.A class 1). Resolution and the bank
/// reference live in merchant_bank_ref, not here (T2). A new Program for an
/// existing merchant is a NEW enrollment, never a new merchant (I1, I5).
model Enrollment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  programId  String   @map("program_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  status     String // ACTIVE | SUSPENDED
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([programId, merchantId])
  @@map("enrollment")
}

/// Transactional outbox (E1). A state change and its emitted fact commit
/// atomically in one local transaction. IDs-only payloads, no PII (S7), no
/// secrets (S4).
model Outbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  partitionKey  String    @map("partition_key")
  payload       Json      @db.JsonB
  headers       Json?     @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)

  @@index([publishedAt, createdAt])
  @@map("outbox")
}

/// Consumer inbox for effectively-once local effects (E6). Dedup on
/// (consumer, dedup_key); the insert and the effect commit in one local
/// transaction. No money floor anywhere (S20).
model Inbox {
  consumer    String
  dedupKey    String   @map("dedup_key")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, dedupKey])
  @@map("inbox")
}
