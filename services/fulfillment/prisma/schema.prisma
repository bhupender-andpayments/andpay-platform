// Fulfillment context persistence (handoff spec 02).
// This schema.prisma carries ONLY the shared infrastructure tables (outbox,
// inbox). Domain tables arrive in later specs. The datasource is pinned to the
// `fulfillment` schema of the shared instance via the ?schema= parameter in the
// connection string; this client can never see another context's schema (C4).
//
// Isolation note (spec 9): these infrastructure tables carry no tenant-visible
// rows, so RLS is not yet applicable. RLS and program_id scoping arrive with the
// domain tables in later specs; this is a DEFERRED item, not silently skipped.

datasource db {
  provider = "postgresql"
  url      = env("FULFILLMENT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

/// Transactional outbox (E1). A state change and its emitted fact commit
/// atomically in one local transaction. IDs-only payloads, no PII (S7), no
/// secrets (S4).
model Outbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  partitionKey  String    @map("partition_key")
  payload       Json      @db.JsonB
  headers       Json?     @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)

  @@index([publishedAt, createdAt])
  @@map("outbox")
}

/// Consumer inbox for effectively-once local effects (E6). Dedup on
/// (consumer, dedup_key); the insert and the effect commit in one local
/// transaction. No money floor anywhere (S20).
model Inbox {
  consumer    String
  dedupKey    String   @map("dedup_key")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, dedupKey])
  @@map("inbox")
}

/// Fulfillment vendor registry (D115/D121; the vndr_ business entity is
/// Fulfillment-owned, the class-6 credential binding it is Auth-owned). PLATFORM
/// -ONLY (a vendor references no Program). FORCE RLS permissive in v1.
model Vendor {
  id          String   @id @db.Uuid
  type        String // MANUFACTURER | PRINT | COURIER
  displayName String   @map("display_name")
  status      String // ACTIVE | SUSPENDED
  courierCode String?  @unique @map("courier_code")
  // Phase 3 Task 2 (BRD FR-11): the courier integration channel, WEBHOOK or
  // BATCH. Nullable, applies to COURIER rows only (a MANUFACTURER/PRINT vndr
  // leaves this null); no credential of any kind lives here (S4, class-6 is
  // Auth-owned, see CredentialProjection below).
  integrationMode String? @map("integration_mode")
  // W-6 (Task 12): the PRINT vendor's press-layout capability, ONE_PER_PAGE or
  // GRID_3X2 (a later task reads this at PDF assembly time). NOT NULL with a
  // DB DEFAULT so every pre-existing row (including MANUFACTURER/COURIER,
  // where the value is simply unused) lands on today's contract without a
  // backfill. Admin-writable only through setVendorPrintLayout (ops.ts),
  // which restricts the write to PRINT vendors.
  printLayout String @default("ONE_PER_PAGE") @map("print_layout")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("vndr")
}

/// The Unit aggregate (D106a/b). A common lifecycle spine with typed detail
/// (T10): SERIALIZED devices carry device_serial (the natural birth key from the
/// intake sheet) + device_qr detail; QUANTITY_LINE collateral carries a qr_string
/// (the Acceptance/TMS value, transmitted never minted, T2) + running counts.
/// PLATFORM-ONLY (raw inventory, not merchant/Program-attributed at birth). Born
/// ONLY at manufacturer intake (D103d). shipment/printed_for_merchant stay null
/// until the return sheet (spec 08).
model Unit {
  id                 String   @id @db.Uuid
  kind               String // SERIALIZED | QUANTITY_LINE
  productType        String   @map("product_type") // SOUNDBOX | STANDEE | STICKER | ...
  manufacturerVndr   String   @map("manufacturer_vndr") @db.Uuid
  batch              String?  @db.Uuid
  status             String
  // serialized-only
  deviceSerial       String?  @unique @map("device_serial")
  deviceQr           Json?    @map("device_qr") @db.JsonB
  // The manufacturer file's "Sim No" column (an ICCID), captured at intake.
  // Subscriber-linkable, sensitive-by-default: stored here, but NEVER emitted
  // on a fact (S7) and not granted to any read role, pending the architecture
  // PII/residency ruling. No @unique in this additive step (the intake INSERT's
  // ON CONFLICT targets device_serial only; a sim_no UNIQUE would turn a
  // duplicate ICCID into a whole-file E1 rollback) - uniqueness is an OPEN
  // question for the ratifying spec.
  simNo              String?  @map("sim_no")
  shipment           String?  @db.Uuid
  printedForMerchant String?  @map("printed_for_merchant") @db.Uuid
  // The assignment this unit was printed for. Activation and damage both happen
  // against an ASSIGNMENT, and a merchant can hold several over time (a
  // replacement is a new assignment for the same merchant), so
  // printed_for_merchant is too coarse to carry an activation back to the right
  // device. Nullable: stock exists before it is paired to anything.
  asgnId             String?  @map("asgn_id") @db.Uuid
  location           String?
  // quantity-line-only
  qrString           String?  @map("qr_string")
  procured           Int?
  allocated          Int?
  printed            Int?
  dispatched         Int?
  delivered          Int?
  returned           Int?
  scrapped           Int?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Non-unique index backing the intake-time duplicate-ICCID lookup (SELECT ...
  // WHERE sim_no = ?). NOT @unique: the BRD treats a duplicate ICCID as a
  // flag-for-review case (windowed detection), never an all-time uniqueness
  // assertion, so a legitimate SIM re-use is adjudicated by ops, not rejected
  // by a constraint.
  @@index([simNo])
  @@index([asgnId])
  @@map("unit")
}

/// The per-pool demand projection built from fct.tms.assignment.v1 (T7). Holds
/// the event-carried snapshot for spec-08 composition with no C4 read (D116).
/// PROGRAM-SCOPED (07.A class 1): program_id write-gate.
model PendingPoolEntry {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asgnId              String   @unique @map("asgn_id") @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  programId           String   @map("program_id") @db.Uuid
  soundbox            Boolean
  // W-5: the dispatch group marker off fct.tms.assignment.v1, NULL for a
  // legacy combined row. Deliberately never backfilled; downstream
  // membership and pairing branch on that NULL to keep pre-split semantics.
  dispatchGroup       String?  @map("dispatch_group")
  standeeCount        Int      @map("standee_count")
  stickerCount        Int      @map("sticker_count")
  billable            Boolean
  merchantDisplayName String   @map("merchant_display_name")
  merchantLegalName   String   @map("merchant_legal_name")
  merchantMcc         String   @map("merchant_mcc")
  bankReferenceCode   String   @map("bank_reference_code")
  bankDisplayName     String   @map("bank_display_name")
  shipToAddress       String   @map("ship_to_address")
  qrValue             String   @map("qr_value")
  vpaValue            String   @map("vpa_value")
  poolStatus          String   @map("pool_status") // POOLED | HELD | BATCHED
  batch               String?  @db.Uuid
  sourceEventId       String   @map("source_event_id")
  // E4 trace propagation through the pool projection (S21, Field 9): captured from
  // the demand fact at pool-insert; the batch fact carries the deterministically-
  // oldest batched entry's trace_id (critique fix C5).
  traceId             String   @map("trace_id")
  // record-HOLD is an audited class-3 op (S13); the hold actor lives here because a
  // HOLD never creates a Batch (critique fix). The tamper-evident 6e write is step 9.
  heldByActor         String?  @map("held_by_actor") @db.Uuid
  heldAt              DateTime? @map("held_at") @db.Timestamptz(6)
  // spec 08: the Fulfillment-owned dispatch state, advanced by the dispatch PM
  // (distinct from pool_status and from any TMS state, T2/T12).
  dispatchState       String?  @map("dispatch_state") // QR_GENERATED | SENT_TO_VENDOR | DISPATCHED_BY_VENDOR
  // spec 08: the merchant id, carried in the event-carried snapshot so print-for
  // can set unit.printed_for_merchant with no C4 read (D116). Populated by
  // projectDemandFact from the demand fact's mrchId.
  merchantId          String?  @map("merchant_id") @db.Uuid
  // spec 08: D116 consume-and-lock. amendment_seq gates monotonic apply; a
  // post-composition amend sets superseded=true and stores the pending new
  // address (the reissue is a recorded deferral). superseded_ship_to is PII,
  // redacted from every log line (S7/S4).
  shipToAmendmentSeq  Int?     @map("ship_to_amendment_seq")
  shipToSuperseded    Boolean  @default(false) @map("ship_to_superseded")
  supersededShipTo    String?  @map("superseded_ship_to")
  // controller correction: the TMS spec 06a recipient contact snapshot
  // (contact_name/mobile on fct.tms.assignment.v1), carried here so the
  // dispatch label/ship adapter never needs a cross-context read (C4).
  // Entitled shipping-recipient PII (D104), redacted from logs (S7).
  // Populated by the pool projection (a later task).
  shipToContactName   String?  @map("ship_to_contact_name")
  shipToMobile        String?  @map("ship_to_mobile")
  // Phase 3 Task 5a: the branch code snapshot carried on
  // fct.tms.assignment.v1 (T4, D120 FULL-compat, optional on the wire).
  // Populated by projectDemandFact from the demand fact's branchCode; a fact
  // without one (a pre-T4 / legacy fact) leaves this null. Drives the
  // bank_composition_config branch-aware lookup in dispatch.ts.
  branchCode          String?  @map("branch_code")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Spec 10c: additive class-3 ops release stamp (nullable, expand-contract).
  releasedByActor     String?  @map("released_by_actor") @db.Uuid
  releasedAt          DateTime? @map("released_at") @db.Timestamptz(6)
  // The SECOND AWB this dispatch id travels under: the collateral-only parcel
  // (a standee shipped apart from the soundbox kit). Holds shpt.id, a uuid,
  // exactly as unit.shipment does, and NEVER the AWB string (one AWB is one
  // shpt, D106c). Null until a serial-less return row reports it, and at most
  // ONE per dispatch id, so an assignment carries at most two AWBs in total.
  // It hangs here rather than on a Unit because a serial-less row has no unit
  // to find and D103d forbids birthing one; see migration
  // 20260810120000_collateral_shipment_link for the full reasoning.
  collateralShipment  String?  @map("collateral_shipment") @db.Uuid

  @@map("pending_pool_entry")
}

/// The Batch aggregate (D102). PROGRAM-SCOPED. Born by the batching PM trigger.
model Batch {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  programId        String   @map("program_id") @db.Uuid
  printVndr        String?  @map("print_vndr") @db.Uuid
  triggerReason    String   @map("trigger_reason") // LOT_SIZE | MAX_WAIT | MANUAL
  triggeredByActor String?  @map("triggered_by_actor") @db.Uuid
  /// BRD 5.3.4: the operator's free-text reason for a MANUAL (force-dispatch)
  /// trigger. NULL for LOT_SIZE and MAX_WAIT, which have no human behind them.
  /// The domain-column precedent is shpt_status_event.override_reason: operator
  /// free text lives on the domain row, never on the IDs-only 6e authz record
  /// (DD1) and never on the batch fact.
  triggerNote      String?  @map("trigger_note")
  unitCount        Int      @map("unit_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("batch")
}

/// The per-(tenant, program) pool anchor (implementation of "one PM instance per
/// pool"). Maps a pool to its saga_instance so the engine's setTimer (which needs
/// a saga_instance FK) can anchor the pool's max-wait timer. PROGRAM-SCOPED.
/// Lot-size/max-wait config is the DB-backed batching_config store (Phase 3 Task
/// 6, revising S23's code-as-config), resolved by src/config/resolvePoolConfig.
model BatchPool {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  programId     String   @map("program_id") @db.Uuid
  pmInstanceId  String   @map("pm_instance_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, programId])
  @@map("batch_pool")
}

/// Quarantine home for D103d partial-file intake (SPEC Field 2). A malformed or
/// ambiguous row in an otherwise valid manufacturer sheet lands here (plus an ops
/// case) while the certain rows create Units. IDs/enums only, no PII, no raw QR
/// (S7). PLATFORM-ONLY, permissive FORCE RLS in v1. No updated_at (append-only).
model IntakeException {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vndrId     String   @map("vndr_id") @db.Uuid
  fileId     String   @map("file_id")
  rowRef     String   @map("row_ref")
  reasonCode String   @map("reason_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Spec 10c: additive class-3 ops resolution stamp (nullable, expand-contract).
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByActor String?   @map("resolved_by_actor") @db.Uuid

  @@map("intake_exception")
}

/// Phase 5 Task 1 (D-G, FR-01a V2): the ops device-inventory upload-audit
/// ledger, distinct from the 6e authz audit. One row per upload attempt:
/// uploader, timestamp, row counts, status. Modeled on TMS's IngestFile plus
/// the uploader column that lacks. PLATFORM-ONLY, permissive FORCE RLS in v1.
model DeviceInventoryUpload {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileId           String   @map("file_id")
  uploader         String   @db.Uuid
  manufacturerVndr String   @map("manufacturer_vndr") @db.Uuid
  rowTotal         Int      @map("row_total")
  rowAccepted      Int      @map("row_accepted")
  rowFlagged       Int      @map("row_flagged")
  rowInvalid       Int      @map("row_invalid")
  status           String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("device_inventory_upload")
}

/// The D77 engine state tables, copied VERBATIM from the orchestrator engine DDL
/// (the engine is schema-agnostic; these live in the fulfillment schema so the
/// fulfillment-context PM never touches another schema, C4/D107b). Permissive RLS.
model SagaInstance {
  id          String    @id @db.Uuid
  flowType    String    @map("flow_type")
  flowVersion Int       @map("flow_version")
  currentStep String?   @map("current_step")
  status      String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  steps       SagaStep[]
  timers      SagaTimer[]

  @@map("saga_instance")
}

model SagaStep {
  instanceId     String       @map("instance_id") @db.Uuid
  name           String
  status         String
  attempts       Int          @default(0)
  lastErrorClass String?      @map("last_error_class")
  idempotencyKey String       @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  instance       SagaInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([instanceId, name])
  @@map("saga_step")
}

model SagaTimer {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId String       @map("instance_id") @db.Uuid
  fireAt     DateTime     @map("fire_at") @db.Timestamptz(6)
  purpose    String
  status     String       @default("pending")
  claimedAt  DateTime?    @map("claimed_at") @db.Timestamptz(6)
  instance   SagaInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, fireAt])
  @@map("saga_timer")
}

/// The retained QR collateral (D104-entitled label artifact, FR-03 "stored
/// against the Dispatch ID"). Holds display name + QR/VPA (entitled, retained
/// 24mo NFR); NO shipping recipient PII, NO KYC/PAN/GSTIN. PROGRAM-SCOPED.
model ComposedArtifact {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asgnId           String   @map("asgn_id") @db.Uuid
  btchId           String   @map("btch_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  programId        String   @map("program_id") @db.Uuid
  artifactType     String   @map("artifact_type") // SOUNDBOX_IMG | STANDEE_IMG | STICKER_IMG
  assetReference   String   @map("asset_reference") // India-resident object-store ref (S6); rasterization deferred
  labelDisplayName String   @map("label_display_name") // entitled label content (merchant display name)
  labelQr          String   @map("label_qr") // the QR/VPA value, transmitted never minted (T2)
  bankConfigRef    String?  @map("bank_config_ref") @db.Uuid // reference to bank_composition_config.id, if present
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Spec 10c: additive class-3 ops supersede stamp (nullable, expand-contract).
  supersededBy     String?  @map("superseded_by") @db.Uuid
  supersededAt     DateTime? @map("superseded_at") @db.Timestamptz(6)

  @@map("composed_artifact")
}

/// The Shipment aggregate (D106c). One AWB = one shpt_ (dedup on awb UNIQUE).
/// courier_partner is the vndr_ of type COURIER, bound from the return
/// sheet's courier_code on shpt BIRTH (spec 09); an omitted or unresolvable
/// code leaves it NULL, never rebound on an AWB dedup hit. status born
/// DISPATCHED_BY_VENDOR; carrier states advanced ONLY by the spec-09 courier
/// channel. PROGRAM-SCOPED.
model Shpt {
  id             String   @id @db.Uuid
  awb            String   @unique
  courierPartner String?  @map("courier_partner") @db.Uuid
  status         String // DISPATCHED_BY_VENDOR | PICKED_UP | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | FAILED | RETURNED
  statusAt       DateTime? @map("status_at") @db.Timestamptz(6)
  statusSource   String?   @map("status_source") // WEBHOOK | BATCH_FILE | OPS_MANUAL
  dispatchDate   DateTime @map("dispatch_date") @db.Timestamptz(6)
  tenantId       String   @map("tenant_id") @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("shpt")
}

/// Fulfillment composition config (FR-03/FR-11), keyed by bank reference. Logo
/// master + required derivative asset refs (India object store, S6), branding
/// params, image templates per product_type as JSONB. NOT identity, NOT PII
/// (S5-minimized). Tenant-keyed REFERENCE; permissive FORCE RLS in v1 (write-
/// gated at step 9). Rows seeded by tests in v1; upload UI is step 9.
model BankCompositionConfig {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  bankCode          String   @map("bank_code")
  // Phase 3 Task 5a: widens the config key to (tenant, bank, branch). NEVER
  // NULL (Postgres treats NULLs as distinct in a unique index, which would
  // let duplicate bank-level-default rows through); the bank-level default
  // row is the '' empty-string sentinel, never null. A branch-specific row
  // stores its own branch code. This keeps a plain UNIQUE enforcing exactly
  // one bank-level-default row per (tenant, bank). The resolver
  // (dispatch.ts bankConfigRefFor) mirrors this sentinel: it queries an
  // exact branch match first, then falls back to branch_code = ''.
  branchCode        String   @default("") @map("branch_code")
  // Phase 3 Task 5b: both nullable. A row born from a branding/template-only
  // upsert (upsertBankCompositionConfig) carries no logo yet; a logo upload
  // (setBankLogo) sets logoMasterRef and explicitly nulls logoDerivativeRef
  // (rasterization deferred, so a stale derivative is invalidated rather than
  // left pointing at the superseded master).
  logoMasterRef     String?  @map("logo_master_ref")
  logoDerivativeRef String?  @map("logo_derivative_ref")
  // Track B (2026-08-10 spec): the vector background masters, keyed by
  // DELIVERY GROUP (soundbox / collateral) because sticker and standee share
  // one artwork. Set only by setBankTemplateMaster, which enforces that the
  // two masters of one row share one page box (the M2 equal-trim guarantee).
  soundboxTemplateRef   String? @map("soundbox_template_ref")
  collateralTemplateRef String? @map("collateral_template_ref")
  brandingParams    Json     @map("branding_params") @db.JsonB
  imageTemplates    Json     @map("image_templates") @db.JsonB // per product_type {SOUNDBOX,STANDEE,STICKER}
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, bankCode, branchCode])
  @@map("bank_composition_config")
}

/// Admin-writable batching parameters (Phase 3 Task 6, BRD 5.3.2), revising
/// S23's code-as-config. minLotSize + maxWaitSeconds for one scope. The scope
/// key is (tenantWire, programWire) with the '' empty-string sentinel (NEVER
/// NULL, mirroring bank_composition_config's branch_code / T5a): a GLOBAL
/// default row is ('', ''); a per-tenant default is (tenantWire, ''); a
/// per-(tenant, program) override is (tenantWire, programWire). Wire ids
/// (public form). An EMPTY table reproduces the code DEFAULT (50 / 7 days) for
/// every pool via resolvePoolConfig's fallback. Platform master data;
/// permissive FORCE RLS (v1), write-gated by the fulfillment_write GRANT.
model BatchingConfig {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantWire     String   @default("") @map("tenant_wire")
  programWire    String   @default("") @map("program_wire")
  minLotSize     Int      @map("min_lot_size")
  maxWaitSeconds Int      @map("max_wait_seconds")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantWire, programWire])
  @@map("batching_config")
}

/// Append-only carrier-status trail (BRD FR-06: each update is timestamped and
/// stored). NEVER mutated; a correction is a new forward event (107a). The
/// latest status is denormalized onto shpt.status/status_at under
/// last-status-wins (C3); shpt_ stays the sole owner (T2). PROGRAM-SCOPED.
/// courier_timestamp is REPORTED data; received_at is platform time (S22).
model ShptStatusEvent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shptId           String   @map("shpt_id") @db.Uuid
  programId        String   @map("program_id") @db.Uuid
  status           String
  courierTimestamp DateTime @map("courier_timestamp") @db.Timestamptz(6)
  statusSource     String   @map("status_source")
  sourceRef        String   @map("source_ref")
  receivedAt       DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  traceId          String   @map("trace_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Spec 10c: additive class-3 ops override reason (nullable, expand-contract).
  overrideReason   String?  @map("override_reason")

  @@index([shptId])
  @@map("shpt_status_event")
}

/// Courier-channel quarantine (103d), sibling of intake_exception. An unknown
/// AWB or courier is recorded here, NEVER auto-created. Carries no program_id:
/// an unresolved AWB has no Program yet. file_id/row_ref are null on webhook.
model CourierStatusException {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vndrId     String   @map("vndr_id") @db.Uuid
  channel    String // BATCH_FILE | WEBHOOK
  subjectRef String   @map("subject_ref")
  fileId     String?  @map("file_id")
  rowRef     String?  @map("row_ref")
  reasonCode String   @map("reason_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Spec 10c: additive class-3 ops resolution stamp (nullable, expand-contract).
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByActor String?   @map("resolved_by_actor") @db.Uuid

  @@map("courier_status_exception")
}

/// The Fulfillment-side (5c verifier plane) LOCAL copy of the class-6
/// credential projection, upserted from Auth's auth-config channel
/// (cfg.auth.credential.v1, Task 4). This is the projection the HTTP edge
/// (later tasks) resolves an apsk_ secret against with ZERO call to Auth (5c/
/// 5e): one HMAC over the runtime-injected pepper, one lookup by
/// peppered_hash. IDs, enums, and the peppered hash ONLY (S7/S4). PLATFORM-
/// ONLY (no Program scope, a verifier-plane row is not merchant/Program-
/// attributed), permissive FORCE RLS in v1 (matches vndr_v1/unit_v1). No
/// expires_at column: Task 4's cfg payload carries none (D3 class-6
/// credentials do not expire).
model CredentialProjection {
  apiId            String   @id @map("api_id") @db.Uuid
  pepperedHash     String   @unique @map("peppered_hash")
  vndrId           String   @map("vndr_id") @db.Uuid
  workQueue        String   @map("work_queue")
  permissionSetRef String   @map("permission_set_ref")
  mode             String
  status           String // ACTIVE | REVOKED
  epoch            Int
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("credential_projection")
}
