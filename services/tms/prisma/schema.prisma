// TMS-thin persistence (handoff spec 06, built on spec 02 topology).
// Pinned to the `tms` schema of the shared instance via the ?schema= parameter
// in TMS_DATABASE_URL; this client can never see another context's schema (C4).
// Domain tables: assignment (the demand aggregate, Program-scoped), pending_row
// (ingest staging ahead of Identity resolution), merchant_projection and
// tenant_projection (event-carried read-models from fct.identity.*, T7),
// ingest_file and quarantine_row (the S8 ingest ledger). Plus the shared outbox
// (E1) and inbox (E6). No Fulfillment status columns (T2, T12), no money (S20).
//
// RLS: FORCE ROW LEVEL SECURITY on every table (S13, gate item 17 PARTIAL).
// assignment alone carries the program_id WITH CHECK write-gate (07.A class 1);
// the rest are permissive in v1 (ratified): they are written at ingest before
// the Program resolves, or are event-fed read-models with no prog_ to gate on.

datasource db {
  provider = "postgresql"
  url      = env("TMS_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

/// Transactional outbox (E1). A state change and its emitted fact commit
/// atomically in one local transaction. IDs-only payloads, no PII (S7), no
/// secrets (S4).
model Outbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  partitionKey  String    @map("partition_key")
  payload       Json      @db.JsonB
  headers       Json?     @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)

  @@index([publishedAt, createdAt])
  @@map("outbox")
}

/// Consumer inbox for effectively-once local effects (E6). Dedup on
/// (consumer, dedup_key); the insert and the effect commit in one local
/// transaction. No money floor anywhere (S20).
model Inbox {
  consumer    String
  dedupKey    String   @map("dedup_key")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, dedupKey])
  @@map("inbox")
}

/// The demand aggregate (07.A class 1, Program-scoped). Externally the BRD
/// Dispatch ID. References mrch_/prog_/tnnt_ (I5, T3); carries event-carried
/// snapshots and the bank-supplied QR/VPA value (D116, D117). NO Fulfillment
/// status column (T2, T12). source_event_id is the {file_id}|{row_no} that
/// created it (06.A); W-5 widens idempotency from UNIQUE(source_event_id) to
/// UNIQUE(source_event_id, dispatch_group), one assignment per dispatch group.
model Assignment {
  id                  String    @id @db.Uuid
  merchantId          String    @map("merchant_id") @db.Uuid
  programId           String    @map("program_id") @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  merchantDisplayName String    @map("merchant_display_name")
  merchantLegalName   String    @map("merchant_legal_name")
  merchantMcc         String    @map("merchant_mcc")
  bankReferenceCode   String    @map("bank_reference_code")
  bankDisplayName     String    @map("bank_display_name")
  shipToAddress       String    @map("ship_to_address")
  // spec 06a: recipient contact snapshot (BRD FR-01b bank-file columns, FR-04
  // dispatch label). Entitled shipping-recipient PII (D104), redacted from logs
  // (S7). Nullable at the DB (additive to a BUILT-V1 table, and the fact fields
  // are optional under D120 FULL compat); ingest makes them mandatory per row.
  contactName         String?   @map("contact_name")
  mobile              String?
  // Phase 3 Task 4: mandatory bank-file Branch Code snapshot (BRD 5.1b).
  // TMS-local snapshot data, not an identity key (the tenant keys on
  // bank_reference_code); it feeds analytics DispatchRow.branch via the
  // assignment fact. Nullable at the DB (additive to a BUILT-V1 table, and the
  // fact field is optional under D120 FULL compat); ingest makes it mandatory
  // per row, exactly like contact_name/mobile.
  branchCode          String?   @map("branch_code")
  qrValue             String    @map("qr_value")
  vpaValue            String    @map("vpa_value")
  soundbox            Boolean
  standeeCount        Int       @map("standee_count")
  stickerCount        Int       @map("sticker_count")
  billable            Boolean
  replacementOf       String?   @map("replacement_of") @db.Uuid
  damageReason        String?   @map("damage_reason")
  bankRemarks         String?   @map("bank_remarks")
  /// Workflow C step 1 (T6.4): what an OPERATOR wrote about this case, as
  /// opposed to bank_remarks above, which is what the BANK wrote on the damage
  /// row. A second column and not an edit of the first, because they are
  /// different people's words and an audit that cannot tell them apart is not
  /// worth keeping. It is what makes the D-22 'others' reason usable: a case
  /// reasoned "others" with no note is a case nobody can work. Free operator
  /// text, so it stays on this domain row and never rides a fact or an audit
  /// record (S7/DD1), the same posture as batch.trigger_note.
  opsRemarks          String?   @map("ops_remarks")
  /// D-27 (Damage and Replacement Workflow, 16 Aug 2026): WHO flagged the
  /// damage that minted this replacement, the flagging operator's principal id
  /// (claim.sub, never a request body, M7/S16). Set only by ops:flag-damage;
  /// null on every original and on every file-born replacement, which predate
  /// the concept and are deliberately not backfilled. An id and not free text
  /// (S4/S7): the why lives in ops_remarks above, the who lives here.
  flaggedBy           String?   @map("flagged_by")
  /// Open | In-Progress | Closed, replacements only. One LIVE (non-Closed)
  /// child per parent is enforced by the migration-only partial unique index
  /// assignment_one_live_case (20260816210000, DP-3/F2); Prisma cannot
  /// express partial indexes, so it does not appear in this schema.
  caseStatus          String?   @map("case_status")
  demandState         String    @map("demand_state") // received | pooled-for-fulfillment | closed | replacement-raised | activated
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz(6)
  /// D-16 activation branch: the LATEST activation status, denormalized off
  /// assignment_activation_event under forward-only-wins, so the common read
  /// needs no aggregate. NULL is a real state (no request has been sent to the
  /// CWD yet), not an unknown. CHECK constrained in the migration; a plain text
  /// column with enum tokens, following demand_state and case_status above.
  /// This is the axis that is INDEPENDENT of delivery: a soundbox can be
  /// activated before, after, or without its delivery being recorded.
  activationStatus    String?   @map("activation_status") // REQUEST_SENT_TO_CWD | ACTIVATED
  // Phase 2 task 3 (D-F): the additional-soundbox provenance marker, computed
  // TMS-side inside the same insert transaction (NO fact-schema change).
  // INITIAL = the first assignment processed for this merchant_id; ADDITIONAL
  // = every later one. This repo's convention favors a plain string column
  // with a comment over a Prisma enum (no enum exists anywhere in this
  // schema), so origin follows demand_state's / case_status's style rather
  // than introducing one. v1 known edge: the marker is decided by processing
  // order, not a DB constraint, so two rows for a brand-new merchant
  // processed concurrently could both observe zero prior assignments and
  // both land INITIAL; acceptable for v1 (informational provenance, not an
  // authoritative ordering guarantee), no locking added for it.
  origin              String    @default("INITIAL") @map("origin") // INITIAL | ADDITIONAL
  sourceEventId       String    @map("source_event_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// W-5: which physical consignment this assignment IS. SOUNDBOX dispatch groups zero
  /// their counts; COLLATERAL dispatch groups carry the row's counts with soundbox=false.
  /// Pre-split rows were backfilled with their dominant dispatch group.
  dispatchGroup       String    @map("dispatch_group")

  @@unique([sourceEventId, dispatchGroup])
  @@map("assignment")
}

/// TMS-internal ingest staging (not a fact). Holds the TMS-owned slice of a
/// request row (demand, QR/VPA value, ship-to) while the assignment awaits the
/// Identity enrollment fact. correlation_id is the {file_id}|{row_no} join key.
/// Permissive in v1 (ratified): written at ingest before Program resolution.
model PendingRow {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correlationId   String   @unique @map("correlation_id")
  tenantReference String   @map("tenant_reference")
  soundbox        Boolean
  standeeCount    Int      @map("standee_count")
  stickerCount    Int      @map("sticker_count")
  qrValue         String   @map("qr_value")
  vpaValue        String   @map("vpa_value")
  shipToAddress   String   @map("ship_to_address")
  // spec 06a: recipient contact snapshot parsed at ingest (BRD FR-01b), carried
  // into the assignment snapshot at creation. Nullable at the DB; ingest-mandatory.
  contactName     String?  @map("contact_name")
  mobile          String?
  // Phase 3 Task 4: mandatory bank-file Branch Code parsed at ingest (BRD 5.1b),
  // carried into the assignment snapshot at creation. Nullable at the DB; ingest-mandatory.
  branchCode      String?  @map("branch_code")
  status          String // awaiting-identity | consumed
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pending_row")
}

/// TMS read-model from fct.identity.merchant.v1 (T7). The source of the
/// assignment's merchant snapshot. Event-carried, never a read of Identity (C4).
model MerchantProjection {
  id          String   @id @db.Uuid
  displayName String   @map("display_name")
  legalName   String   @map("legal_name")
  mcc         String
  status      String   // ACTIVE | SUSPENDED
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("merchant_projection")
}

/// TMS read-model from fct.identity.tenant.v1 (T7). The source of the
/// assignment's bank snapshot.
model TenantProjection {
  id                String   @id @db.Uuid
  displayName       String   @map("display_name")
  bankReferenceCode String   @map("bank_reference_code")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_projection")
}

/// TMS read-model from fct.identity.aggregator.v1 (T7). The Aggregator is
/// Identity's sub-tenant below Tenant (spec 2026-08-20).
model AggregatorProjection {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  aggregatorCode String   @map("aggregator_code")
  displayName    String   @map("display_name")
  status         String
  isDefault      Boolean  @map("is_default")
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, aggregatorCode])
  @@map("aggregator_projection")
}

/// The S8 ingest record. Permissive in v1 (ratified): a file can span Programs
/// and is written before resolution.
model IngestFile {
  fileId          String   @id @map("file_id")
  source          String // bank_request | bank_damage
  tenantReference String   @map("tenant_reference")
  rowTotal        Int      @default(0) @map("row_total")
  rowAccepted     Int      @default(0) @map("row_accepted")
  rowRejected     Int      @default(0) @map("row_rejected")
  status          String // received | processed
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ingest_file")
}

/// Damage-reason master (BRD FR-08, FR-11; Phase 3 Task 1). The admin-managed
/// reference list the flag-damage write (flag-damage.ts flagDamageOps, D-26)
/// validates reasonCode against before minting a replacement; an unknown or
/// deactivated code is refused as a client error (DP-5). Platform-only
/// (no program_id, no merchant scope, permissive v1 RLS): a damage reason is a
/// shared taxonomy across every tenant/program, mirroring vndr's platform-only
/// shape in fulfillment (D115). code is a stable admin-supplied machine
/// identifier (never derived from label, so a later relabel does not change
/// the identifier an integration might reference); label is the human display
/// text the ingest match runs against (case- and whitespace-insensitive, see
/// damage.ts). code is unique on its exact value; label is unique on its
/// NORMALIZED form only (fix-round 1, review finding: the ingest match is
/// case/whitespace-insensitive, so a plain case-sensitive unique on label
/// alone would let an admin create "battery issue" and "Battery Issue " as
/// two DISTINCT rows -- deactivating one then silently does nothing, because
/// the ingest match still finds the other, still-active, normalized-identical
/// row). The normalized-unique index (`lower(trim(label))`) is
/// migration-only, like the RLS policy/grants on this table: Prisma's schema
/// DSL has no functional-index syntax, so it is intentionally NOT declared
/// here (see migration 20260805000000_damage_reason_label_normalized_unique).
/// id is a plain DB-generated uuid, not a typed @andpay/ids prefix: this is
/// internal reference data, never a merchant-facing external id, so no new
/// ID prefix is invented (repo DO-NOT list).
model DamageReason {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("damage_reason")
}

/// Rejected or discrepant rows (S8 row-level rejection, never an auto-create).
/// raw_row is stored redacted for log. Permissive in v1 (ratified).
model QuarantineRow {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileId     String   @map("file_id")
  rowNo      Int      @map("row_no")
  rawRow     String   @map("raw_row")
  reasonCode String   @map("reason_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Spec 10c: additive class-3 ops resolution stamp (nullable, expand-contract).
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByActor String?   @map("resolved_by_actor") @db.Uuid
  /// WHICH of D-8's two actions retired this row: 'cured' (an ingest was
  /// re-driven with a corrected row) or 'closed' (a genuine duplicate,
  /// archived untouched). Not a second resolved flag; resolved_at still answers
  /// whether the row is retired at all. NULL on rows resolved before the
  /// distinction existed, deliberately NOT backfilled, since inventing a
  /// resolution nobody recorded would put a fabricated operator claim in the
  /// archive. Constrained to those two values by a CHECK in migration
  /// 20260812140000.
  resolution      String?   @map("resolution")
  /// Per-reason structured evidence (2026-08-10 soundbox duplicate-VPA ruling).
  /// Today only `duplicate_vpa_soundbox` writes it, as
  /// {"duplicateOf":{"kind","reference","merchantDisplayName"}}, so the ops
  /// queue can NAME the original the held row collides with rather than making
  /// an operator go and find it. Nullable because every other reason code has
  /// no evidence to carry, and JSONB rather than a column set because the shape
  /// is per-reason: a later reason with different evidence needs no migration.
  /// The two supporting functional indexes (lower(vpa_value) on pending_row and
  /// assignment) are migration-only, exactly like damage_reason's normalized
  /// unique index above and for the same reason: the Prisma DSL has no
  /// functional-index syntax. See
  /// migrations/20260810100000_tms_duplicate_vpa_quarantine.
  detail          Json?     @db.JsonB

  @@unique([fileId, rowNo])
  @@map("quarantine_row")
}

/// D-16 activation branch: the append-only activation trail, one row per
/// transition of one Dispatch ID. Modeled on fulfillment's ShptStatusEvent
/// deliberately, because D-16 makes activation the SECOND branch alongside
/// delivery and the two should be shaped alike: never mutated, a correction is
/// a new forward event (107a), and the latest status is denormalized onto the
/// aggregate (assignment.activation_status) under forward-only-wins.
///
/// occurred_at is REPORTED time (when the CWD activated it, when the request
/// went out); created_at is platform time (S22). status_source names WHICH door
/// wrote the row, so the trail reads back without joining the audit ledger.
/// actor_id is nullable because not every writer is a human: the port-driven
/// activateAssignment path has no operator behind it, and NULL there means "no
/// operator", not "we lost it". IDs, enum tokens and timestamps only, no free
/// text (S4, S7). PROGRAM-SCOPED.
model AssignmentActivationEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asgnId       String   @map("asgn_id") @db.Uuid
  programId    String   @map("program_id") @db.Uuid
  status       String // REQUEST_SENT_TO_CWD | ACTIVATED
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)
  statusSource String   @map("status_source") // ops:mark-activated | ops:request-activation | port
  actorId      String?  @map("actor_id") @db.Uuid
  traceId      String   @map("trace_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([asgnId])
  @@map("assignment_activation_event")
}
