{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["packages/*/src", "packages/*/test", "services/*/src", "services/*/test", "apps/*/src", "apps/*/test", "test", "*.config.ts"],
  "exclude": ["apps/ops-portal", "apps/vendor-portal"]
}
