# Local/dev connection strings for the schema-per-context Postgres (spec 02).
# These are NON-SECRET local dev defaults matching infra/docker-compose.dev.yml.
# Copy to a local shell export or use infra/db.sh, which exports these defaults.
# Never put real credentials here or in any committed file (S4).

# One physical instance, one schema per context via the ?schema= parameter.
# The physical split to an instance-per-context later is a URL change only.
IDENTITY_DATABASE_URL="postgresql://andpay:andpay_dev@localhost:5432/andpay?schema=identity"
TMS_DATABASE_URL="postgresql://andpay:andpay_dev@localhost:5432/andpay?schema=tms"
FULFILLMENT_DATABASE_URL="postgresql://andpay:andpay_dev@localhost:5432/andpay?schema=fulfillment"

# Dedicated schema for the @andpay/outbox library's own integration tests.
OUTBOX_TEST_DATABASE_URL="postgresql://andpay:andpay_dev@localhost:5432/andpay?schema=outbox_test"

# Orchestration engine state (spec 03), its own schema on the shared instance.
ORCHESTRATOR_DATABASE_URL="postgresql://andpay:andpay_dev@localhost:5432/andpay?schema=orchestrator"

# Event backbone (spec 03). Local dev stand-in for AWS MSK plus Glue is Redpanda
# (Kafka API plus a built-in, Confluent-compatible schema registry). Production
# targets are MSK and Glue in ap-south-1 via the AWS CDK app under infra/aws.
KAFKA_BROKERS="localhost:19092"
SCHEMA_REGISTRY_URL="http://localhost:18081"
